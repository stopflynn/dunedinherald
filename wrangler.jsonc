{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dunedin-herald",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "vars": {
    "SITE_URL": "https://dunedinherald.com"
  },
  "observability": {
    "enabled": true
  }
}
