# Public website: use a private Sanity dataset and keep this token server-only.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-08-01
SANITY_READ_TOKEN=

# Optional whole-site password gate. Store both as server-only hosting secrets.
# Use a strong password of at least 12 characters and a random signing secret
# of at least 32 characters. Never prefix either key with NEXT_PUBLIC_.
SITE_ACCESS_PASSWORD=
SITE_ACCESS_COOKIE_SECRET=
